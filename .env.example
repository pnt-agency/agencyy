# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# ---------- Database (Postgres, via Docker Compose) ----------
# These three are used by docker-compose.yml to configure the Postgres container.
POSTGRES_USER=agencybuild
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agencybuild
POSTGRES_PORT=5432

# Used by the app (Drizzle) to connect to the database above.
# Host is "localhost" because the app runs outside Docker for now;
# the port must match POSTGRES_PORT.
DATABASE_URL=postgresql://agencybuild:change-me@localhost:5432/agencybuild

# ---------- NextAuth ----------
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Optional — enables "Continue with Google". Leave blank to disable that button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Email (Resend) ----------
RESEND_API_KEY=re_your_resend_api_key

# Sender address. Leave unset to use Resend's sandbox sender
# ("Amaris Partners <onboarding@resend.dev>"), which needs no domain setup but
# ONLY delivers to the email your Resend account is registered under —
# everything addressed elsewhere is rejected. Verify a domain at
# resend.com/domains, then set this to an address on it to send to real users.
EMAIL_FROM=

# Where new-application / new-inquiry notifications are sent. If unset, no
# internal notification is sent (applicant confirmations still go out).
# While on the sandbox sender, set this to your Resend account email — it's
# the one address Resend will actually deliver to.
ADMIN_NOTIFICATION_EMAIL=

# ---------- Bot protection (Cloudflare Turnstile) ----------
# Protects the public /apply and /hire forms. Create a widget at
# dash.cloudflare.com -> Turnstile, add your domain, and copy both keys here.
#
# Leave these unset and captcha verification is SKIPPED. The forms still work
# and are still protected by IP rate limiting, signed form tokens, a honeypot
# and server-side validation — but this is the layer that actually distinguishes
# a browser with a person behind it from a script, so set it in production.
#
# One deliberate side effect while unset: confirmation emails to addresses typed
# into the public forms are not sent, because nothing has verified that a human
# submitted them. Admin notifications are unaffected. Configuring these keys
# turns applicant/employer confirmations back on.

# Public — rendered into the page, safe to expose.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server-only — never expose this one.
TURNSTILE_SECRET_KEY=

# ---------- File storage (Cloudflare R2) ----------
# R2 speaks the S3 API. One PRIVATE bucket holds both CVs (cv/) and training
# videos (training/); nothing in it is ever public. CVs download through
# one-minute signed links issued to admins; videos play through signed links
# minted each time a signed-in member loads the training page (see lib/r2.ts).
# Leave these unset to disable uploads — the app degrades to link-only CVs and
# shows training modules as "coming soon" rather than breaking.
#
# Browsers upload straight to R2, so the bucket needs a CORS policy allowing
# PUT with a Content-Type header from the site's origins
# (R2 → the bucket → Settings → CORS Policy).

# Cloudflare dashboard → R2 → Overview (the account ID in the S3 endpoint).
R2_ACCOUNT_ID=
# R2 → Manage API tokens → Create token with Object Read & Write, scoped to the bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The private bucket. Never enable public access on it.
R2_BUCKET=
